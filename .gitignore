# Agent / tooling metadata — local to this machine, not part of the extension
.freebuff/

# Local secrets — an API key belongs in the extension's options page, never in the tree
.env
.env.*
*.key
*.pem
secrets.json

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# Build output / packaging
node_modules/
dist/
build/
*.zip
*.crx

# Playwright output: traces, videos, failure screenshots and the .last-run marker. Generated by
# `npm run e2e`, never part of the extension.
test-results/
playwright-report/
blob-report/
.playwright/

# The empirical-weight corpus. It is thousands of third-party ladder logs, it is not part of the
# extension, and it is NOT reproducible from a checkout (the replay search window moves as new
# battles are played) — so it is never committed. The tools that produce it write these names:
#   tools/fetch_replays.js       --out replays*.json
#   tools/extract_training_data.js --out training_data*.json
# Only the reviewable artifacts (lib/trained-weights.json, lib/mlp-residual.json) are tracked.
replays*.json
training_data*.json
corpus/
cross-candidates*.json

# The ablation runner's own output. A sweep is a measurement of one machine's battles against the
# three personas at one sample size, not a reviewable artifact of the extension — unlike
# lib/trained-weights.json, which is a fitted model shipped WITH its gate verdict. The command and
# what a sweep found are recorded in CHANGELOG.md; the JSON is there to be re-read locally.
ablation-*.json
ablation-*.log
